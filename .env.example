# Path to the induction corpus (defaults to ./data)
EVIDENCE_ROOM_DATA=./data

# Model to use for embedding (fastembed id; default BAAI/bge-small-en-v1.5)
EVIDENCE_ROOM_EMBED_MODEL=

# Cosine floor for the insufficient-evidence refusal (default 0.65, calibrated
# for bge-small via `python -m evidence_room.evaluate`). Recalibrate if you change
# EVIDENCE_ROOM_EMBED_MODEL.
EVIDENCE_ROOM_MIN_SIM=

# Only needed once retrieval/generation lands
ANTHROPIC_API_KEY=
