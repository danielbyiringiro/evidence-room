{"id": "ans-01", "category": "answerable", "role": "faculty", "question_key": "sum-formula", "rubric_item": "Identify Base Case", "proof": "Base case: let n = 1. Then the left side is 1 and the formula gives 1(1+1)/2 = 1, so the claim holds for n = 1.", "expect": {"decision": "answer", "label": "correct"}, "note": "explicit base case at n=1"}
{"id": "ans-02", "category": "answerable", "role": "faculty", "question_key": "sum-formula", "rubric_item": "Prove Base Case", "proof": "For n = 1 the sum is 1 and 1(1+1)/2 = 1; both sides equal 1, so the base case is verified.", "expect": {"decision": "answer", "label": "correct"}, "note": "base case shown correct"}
{"id": "ans-03", "category": "answerable", "role": "faculty", "question_key": "sum-formula", "rubric_item": "Hypothesis is stated", "proof": "Assume that for some integer k >= 1 the equation 1 + 2 + ... + k = k(k+1)/2 holds.", "expect": {"decision": "answer", "label": "correct"}, "note": "clean IH statement"}
{"id": "ans-04", "category": "answerable", "role": "faculty", "question_key": "sum-formula", "rubric_item": "Inductive Hypothesis is applied", "proof": "Then 1 + 2 + ... + k + (k+1) = k(k+1)/2 + (k+1) by the inductive hypothesis, which simplifies to (k+1)(k+2)/2.", "expect": {"decision": "answer", "label": "correct"}, "note": "IH substituted then simplified"}
{"id": "ans-05", "category": "answerable", "role": "faculty", "question_key": "divisibility", "rubric_item": "Identify Base Case", "proof": "Base case n = 1: 2(1)^3 + 3(1)^2 + 1 = 6, which is divisible by 6.", "expect": {"decision": "answer", "label": "correct"}, "note": "base case identified"}
